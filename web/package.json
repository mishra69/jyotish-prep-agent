{
  "name": "jyotish-prep",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:worker": "npm run build && wrangler dev",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^26.1.2",
    "svelte": "^5.42.2",
    "svelte-check": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wrangler": "^4.118.0"
  }
}
