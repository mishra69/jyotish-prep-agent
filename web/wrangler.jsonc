{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jyotish-prep",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",

  // The Svelte app. /api/* reaches the Worker first; everything else is served
  // straight from assets, with unknown paths falling back to index.html.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jyotish-prep",
      // Filled in by `wrangler d1 create jyotish-prep`. Local dev ignores it.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],

  "vars": {
    // The Cloud Run chart service (api/main.py). Stable across its deploys.
    "CHART_API_URL": "https://jyotish-chart-api-580356242956.us-central1.run.app"
  },

  // Secrets, set with `wrangler secret put` (and in .dev.vars for local dev):
  //   CHART_API_KEY       must equal the chart service's API_KEY
  //   OPENROUTER_API_KEY

  "observability": { "enabled": true }
}
